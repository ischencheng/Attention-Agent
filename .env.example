GEMINI_API_KEY=your_gemini_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
CARAVO_API_KEY=your_caravo_api_key_here

# Codex CLI is open source; hosted model usage requires separate authentication.
# Local deployment uses the host's existing Codex login without copying it.
# Optional container-agents profile needs separate device authentication.
CODEX_API_KEY=
CODEX_CLI_VERSION=0.163.0
CODEX_MODEL=gpt-6.1-sol
MID_CODEX_MODEL=gpt-6-luna
STRONG_CODEX_MODEL=gpt-6.1-sol
CODEX_TIMEOUT_SECONDS=900
# Keep historical keys so switching runtimes preserves pending themes/theses.
MID_AGENT_ID=claude-mid
STRONG_AGENT_ID=claude-strong
# Original topic scope; these are research interests, not a fixed portfolio.
RESEARCH_CONTEXT=ai,earnings,guidance,capex,datacenter,storage,power,energy,nuclear,semiconductor,gpu,inference,llm,margin,valuation,cpi,fed,yield

# Local pipeline defaults; Gemini can still be selected explicitly.
CLASSIFICATION_PROVIDER=codex
# The upstream relay makes no model call; Fast uses the host gateway model.
CODEX_GATEWAY_MODEL=gpt-6-luna
CLASSIFICATION_MODEL=gpt-6-luna
EMBEDDING_PROVIDER=http
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Gateway token is generated automatically under ignored runtime data.

# Discovery-triggered verification; contact/key values stay local.
SEC_EDGAR_USER_AGENT=
FRED_API_KEY=
