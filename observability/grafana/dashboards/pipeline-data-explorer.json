          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', created_at) AS time,\n       metric,\n       COUNT(*)::double precision AS value\nFROM (\n  SELECT created_at, 'attention_ticket'::text AS metric FROM attention_tickets\n  UNION ALL\n  SELECT created_at, 'annotation'::text AS metric FROM annotations\n  UNION ALL\n  SELECT created_at, 'decision_packet'::text AS metric FROM decision_packets\n) t\nWHERE created_at >= NOW() - INTERVAL '2 hours'\nGROUP BY 1, 2\nORDER BY 1;",
